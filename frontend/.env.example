# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Google Maps JavaScript API Key
VITE_MAPS_KEY=your_google_maps_js_api_key_here

# URL de la Cloud Function desplegada
VITE_CF_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/optimize_route

# Firebase – copia estos valores desde la consola de Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id
